node_modules/

# Run history and captured frames stay on this machine. Frames of a Project can
# contain anything that Project renders, so nothing here is committed by
# accident -- see docs/adr/0007.
out/
runs/

# Compiled output.
dist/
*.tsbuildinfo

# Every change gets its own worktree under here, so these are checkouts of this
# repository inside itself -- a `git add -A` that catches one commits it as a
# gitlink nobody can resolve. The guard that puts them there stays committed:
# .claude/settings.json, .claude/hooks/ and .claude/worktree-per-change.json,
# because a worktree only gets a file if git puts it there.
.claude/worktrees/
.claude/settings.local.json
