node_modules/

# Run history and captured frames stay on this machine. Frames of a Project can
# contain anything that Project renders, so nothing here is committed by
# accident -- see docs/adr/0007.
out/
runs/

# Compiled output.
dist/
*.tsbuildinfo

# One worktree per change lives here. The hook and its config beside them are
# committed, because a worktree only gets a file if git puts it there.
.claude/worktrees/
.claude/settings.local.json
