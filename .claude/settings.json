{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-S",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-guard.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking this change is in its own worktree"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-S",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-S",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-guard.py"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git diff-tree:*)",
      "Bash(git diff-index:*)",
      "Bash(git blame:*)",
      "Bash(git shortlog:*)",
      "Bash(git describe:*)",
      "Bash(git name-rev:*)",
      "Bash(git grep:*)",
      "Bash(git count-objects:*)",
      "Bash(git reflog show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git show-ref:*)",
      "Bash(git ls-remote:*)",
      "Bash(git symbolic-ref --short:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git branch -v:*)",
      "Bash(git branch -vv:*)",
      "Bash(git branch --merged:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git check-ignore:*)",
      "Bash(git check-attr:*)",
      "Bash(git config --get:*)",
      "Bash(git config --get-all:*)",
      "Bash(git config --list:*)",
      "Bash(git remote -v:*)",
      "Bash(git remote get-url:*)",
      "Bash(git remote show:*)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(gh label list:*)",
      "Bash(gh search:*)",
      "Bash(gh auth status:*)",
      "Bash(python .claude/scripts/land.py:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin HEAD:*)",
      "Bash(git switch -c:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git branch -D:*)"
    ]
  }
}
